# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Path to the service account key downloaded from the Firebase console
# (Project settings > Service accounts > Generate new private key).
# Save it as server/serviceAccountKey.json. Never commit that file either.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
